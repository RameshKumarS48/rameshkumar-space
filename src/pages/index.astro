---
import { products, type ProductMeta } from "../data/products";
import "../styles/global.css";

interface DnsRecord {
  type: string;
  name: string;
}

interface ProductCard {
  subdomain: string;
  url: string;
  meta: ProductMeta;
}

let cards: ProductCard[] = [];
const zoneId = import.meta.env.CF_DNS_ZONE_ID;
const apiToken = import.meta.env.CF_DNS_TOKEN;

if (zoneId && apiToken) {
  const res = await fetch(
    `https://api.cloudflare.com/client/v4/zones/${zoneId}/dns_records?per_page=100`,
    { headers: { Authorization: `Bearer ${apiToken}` } }
  );
  const data = await res.json();
  if (data.success) {
    const seen = new Set<string>();
    for (const record of data.result as DnsRecord[]) {
      if (!["A", "CNAME", "AAAA"].includes(record.type)) continue;
      if (record.name === "rameshkumar.space") continue;
      if (!record.name.endsWith(".rameshkumar.space")) continue;
      const subdomain = record.name.replace(".rameshkumar.space", "");
      if (seen.has(subdomain)) continue;
      seen.add(subdomain);
      cards.push({
        subdomain,
        url: `https://${record.name}`,
        meta: products[subdomain] ?? {
          name: subdomain.charAt(0).toUpperCase() + subdomain.slice(1),
          description: "A new product — description coming soon.",
          status: "wip",
          emoji: "🚀",
        },
      });
    }
  }
} else {
  cards = Object.entries(products).map(([subdomain, meta]) => ({
    subdomain,
    url: `https://${subdomain}.rameshkumar.space`,
    meta,
  }));
}

cards.sort((a, b) => {
  if (a.meta.status === "live" && b.meta.status !== "live") return -1;
  if (a.meta.status !== "live" && b.meta.status === "live") return 1;
  return a.meta.name.localeCompare(b.meta.name);
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Ramesh Kumar — Product Builder</title>
    <meta name="description" content="Product builder shipping things at rameshkumar.space. Currently at TruckX. Building in public." />
    <meta property="og:title" content="Ramesh Kumar — Product Builder" />
    <meta property="og:description" content="Shipping ideas fast. Each one lives at its own subdomain." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;1,9..144,300;1,9..144,400&family=DM+Sans:wght@300;400;500&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      :root {
        --cream: #F7F4EF;
        --cream-dark: #EEEBE4;
        --ink: #1C1917;
        --ink-soft: #57534E;
        --ink-muted: #A8A29E;
        --accent: #D4522A;
        --accent-light: #FDF0EB;
        --border: #E4DDD5;
        --white: #FFFFFF;
      }

      html { scroll-behavior: smooth; }

      body {
        background: var(--cream);
        color: var(--ink);
        font-family: 'DM Sans', sans-serif;
        font-weight: 300;
        line-height: 1.6;
        min-height: 100vh;
        -webkit-font-smoothing: antialiased;
      }

      /* ── NAV ── */
      nav {
        max-width: 1100px;
        margin: 0 auto;
        padding: 28px 40px;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .nav-name {
        font-family: 'DM Mono', monospace;
        font-size: 13px;
        letter-spacing: 0.04em;
        color: var(--ink-soft);
        text-decoration: none;
      }

      .nav-links {
        display: flex;
        gap: 28px;
        align-items: center;
      }

      .nav-links a {
        font-size: 13px;
        color: var(--ink-soft);
        text-decoration: none;
        transition: color 0.15s;
        display: flex;
        align-items: center;
        gap: 6px;
      }

      .nav-links a:hover { color: var(--accent); }

      .nav-links svg { width: 15px; height: 15px; }

      /* ── HERO ── */
      .hero {
        max-width: 1100px;
        margin: 0 auto;
        padding: 60px 40px 80px;
      }

      .hero-eyebrow {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 28px;
      }

      .hero-eyebrow-dot {
        width: 8px;
        height: 8px;
        background: var(--accent);
        border-radius: 50%;
        animation: pulse 2s ease-in-out infinite;
      }

      @keyframes pulse {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.6; transform: scale(0.85); }
      }

      .hero-eyebrow-text {
        font-family: 'DM Mono', monospace;
        font-size: 12px;
        letter-spacing: 0.08em;
        color: var(--accent);
        text-transform: uppercase;
      }

      .hero-name {
        font-family: 'Fraunces', serif;
        font-size: clamp(56px, 8vw, 108px);
        font-weight: 300;
        line-height: 0.95;
        letter-spacing: -0.02em;
        color: var(--ink);
        margin-bottom: 12px;
      }

      .hero-name em {
        font-style: italic;
        color: var(--accent);
      }

      .hero-tagline {
        font-family: 'Fraunces', serif;
        font-size: clamp(18px, 2.5vw, 26px);
        font-weight: 300;
        font-style: italic;
        color: var(--ink-soft);
        margin-top: 24px;
        max-width: 560px;
        line-height: 1.4;
      }

      /* ── ABOUT STRIP ── */
      .about-strip {
        border-top: 1px solid var(--border);
        border-bottom: 1px solid var(--border);
        background: var(--white);
      }

      .about-inner {
        max-width: 1100px;
        margin: 0 auto;
        padding: 48px 40px;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 60px;
        align-items: start;
      }

      @media (max-width: 700px) {
        .about-inner { grid-template-columns: 1fr; gap: 32px; }
      }

      .about-label {
        font-family: 'DM Mono', monospace;
        font-size: 11px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--ink-muted);
        margin-bottom: 14px;
      }

      .about-bio {
        font-size: 15px;
        color: var(--ink-soft);
        line-height: 1.75;
      }

      .about-bio strong {
        color: var(--ink);
        font-weight: 500;
      }

      .about-meta {
        display: flex;
        flex-direction: column;
        gap: 16px;
      }

      .meta-row {
        display: flex;
        flex-direction: column;
        gap: 4px;
      }

      .meta-key {
        font-family: 'DM Mono', monospace;
        font-size: 10px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--ink-muted);
      }

      .meta-val {
        font-size: 14px;
        color: var(--ink);
        font-weight: 400;
      }

      .skills-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 20px;
      }

      .skill-chip {
        font-size: 12px;
        padding: 5px 12px;
        border: 1px solid var(--border);
        border-radius: 100px;
        color: var(--ink-soft);
        background: var(--cream);
        white-space: nowrap;
      }

      /* ── PRODUCTS ── */
      .products-section {
        max-width: 1100px;
        margin: 0 auto;
        padding: 72px 40px 100px;
      }

      .section-header {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        margin-bottom: 40px;
      }

      .section-title {
        font-family: 'Fraunces', serif;
        font-size: clamp(28px, 4vw, 44px);
        font-weight: 300;
        letter-spacing: -0.02em;
        color: var(--ink);
      }

      .section-count {
        font-family: 'DM Mono', monospace;
        font-size: 12px;
        color: var(--ink-muted);
        letter-spacing: 0.05em;
      }

      /* ── PRODUCT GRID ── */
      .product-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 2px;
        background: var(--border);
        border: 1px solid var(--border);
        border-radius: 16px;
        overflow: hidden;
      }

      @media (max-width: 900px) {
        .product-grid { grid-template-columns: repeat(2, 1fr); }
      }

      @media (max-width: 580px) {
        .product-grid { grid-template-columns: 1fr; }
      }

      .product-card {
        display: block;
        background: var(--white);
        padding: 28px 28px 24px;
        text-decoration: none;
        color: inherit;
        position: relative;
        overflow: hidden;
        transition: background 0.15s;
      }

      .product-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
        background: var(--accent);
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 0.25s ease;
      }

      .product-card:hover {
        background: var(--accent-light);
      }

      .product-card:hover::before {
        transform: scaleX(1);
      }

      .card-top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        margin-bottom: 20px;
      }

      .card-emoji {
        font-size: 28px;
        line-height: 1;
      }

      .card-status {
        font-family: 'DM Mono', monospace;
        font-size: 10px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        padding: 3px 9px;
        border-radius: 100px;
      }

      .status-live {
        color: #15803D;
        background: #F0FDF4;
        border: 1px solid #BBF7D0;
      }

      .status-beta {
        color: #B45309;
        background: #FFFBEB;
        border: 1px solid #FDE68A;
      }

      .status-wip {
        color: var(--ink-muted);
        background: var(--cream);
        border: 1px solid var(--border);
      }

      .card-name {
        font-family: 'Fraunces', serif;
        font-size: 20px;
        font-weight: 400;
        letter-spacing: -0.01em;
        color: var(--ink);
        margin-bottom: 4px;
        line-height: 1.2;
      }

      .card-url {
        font-family: 'DM Mono', monospace;
        font-size: 10px;
        color: var(--ink-muted);
        margin-bottom: 14px;
        letter-spacing: 0.02em;
      }

      .card-desc {
        font-size: 13px;
        color: var(--ink-soft);
        line-height: 1.65;
      }

      .card-arrow {
        display: flex;
        align-items: center;
        gap: 4px;
        margin-top: 20px;
        font-family: 'DM Mono', monospace;
        font-size: 11px;
        color: var(--ink-muted);
        transition: color 0.15s, gap 0.15s;
      }

      .product-card:hover .card-arrow {
        color: var(--accent);
        gap: 8px;
      }

      /* ── FOOTER ── */
      footer {
        border-top: 1px solid var(--border);
        background: var(--white);
      }

      .footer-inner {
        max-width: 1100px;
        margin: 0 auto;
        padding: 32px 40px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 16px;
      }

      .footer-left {
        font-family: 'DM Mono', monospace;
        font-size: 12px;
        color: var(--ink-muted);
      }

      .footer-links {
        display: flex;
        gap: 24px;
      }

      .footer-links a {
        font-size: 13px;
        color: var(--ink-muted);
        text-decoration: none;
        transition: color 0.15s;
      }

      .footer-links a:hover { color: var(--accent); }

      /* ── MOBILE ── */
      @media (max-width: 600px) {
        nav { padding: 20px 24px; }
        .hero { padding: 40px 24px 60px; }
        .about-inner { padding: 36px 24px; }
        .products-section { padding: 52px 24px 80px; }
        .footer-inner { padding: 28px 24px; }
      }
    </style>
  </head>
  <body>

    <!-- NAV -->
    <nav>
      <a href="/" class="nav-name">rameshkumar.space</a>
      <div class="nav-links">
        <a href="https://linkedin.com/in/ramesh-kumar-saragadam-9b2617142" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.32 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.79M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/></svg>
          LinkedIn
        </a>
        <a href="mailto:srameshkmr48@gmail.com">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"/></svg>
          Email
        </a>
      </div>
    </nav>

    <!-- HERO -->
    <section class="hero">
      <div class="hero-eyebrow">
        <div class="hero-eyebrow-dot"></div>
        <span class="hero-eyebrow-text">Product Builder · Pune, India</span>
      </div>
      <h1 class="hero-name">
        Ramesh<br /><em>Kumar</em>
      </h1>
      <p class="hero-tagline">
        Shipping ideas fast — one subdomain at a time.
      </p>
    </section>

    <!-- ABOUT -->
    <section class="about-strip">
      <div class="about-inner">
        <div>
          <p class="about-label">About</p>
          <p class="about-bio">
            Product builder currently at <strong>TruckX Inc</strong>, previously IIIT Kota.
            I build tools people actually use — fast, focused, and shipped in public.
            Running a personal 21-day shipping challenge: one product per sprint,
            each one live at its own subdomain.
          </p>
          <div class="skills-grid">
            <span class="skill-chip">Product</span>
            <span class="skill-chip">UX Design</span>
            <span class="skill-chip">Building in Public</span>
            <span class="skill-chip">Data Analysis</span>
            <span class="skill-chip">Machine Learning</span>
            <span class="skill-chip">Game Dev</span>
            <span class="skill-chip">Indie Dev</span>
          </div>
        </div>
        <div class="about-meta">
          <div class="meta-row">
            <span class="meta-key">Currently</span>
            <span class="meta-val">TruckX Inc — Pune, India</span>
          </div>
          <div class="meta-row">
            <span class="meta-key">Education</span>
            <span class="meta-val">IIIT Kota</span>
          </div>
          <div class="meta-row">
            <span class="meta-key">Email</span>
            <span class="meta-val"><a href="mailto:srameshkmr48@gmail.com" style="color:var(--accent);text-decoration:none;">srameshkmr48@gmail.com</a></span>
          </div>
          <div class="meta-row">
            <span class="meta-key">LinkedIn</span>
            <span class="meta-val"><a href="https://linkedin.com/in/ramesh-kumar-saragadam-9b2617142" target="_blank" style="color:var(--accent);text-decoration:none;">6K followers</a></span>
          </div>
          <div class="meta-row">
            <span class="meta-key">Products Shipped</span>
            <span class="meta-val">{cards.length} and counting</span>
          </div>
        </div>
      </div>
    </section>

    <!-- PRODUCTS -->
    <section class="products-section">
      <div class="section-header">
        <h2 class="section-title">Things I've shipped</h2>
        <span class="section-count">{cards.length} products live</span>
      </div>

      <div class="product-grid">
        {cards.map(({ subdomain, url, meta }) => (
          <a
            href={url}
            target="_blank"
            rel="noopener noreferrer"
            class="product-card"
          >
            <div class="card-top">
              <span class="card-emoji">{meta.emoji ?? "🚀"}</span>
              {meta.status && (
                <span class={`card-status status-${meta.status}`}>
                  {meta.status}
                </span>
              )}
            </div>
            <div class="card-name">{meta.name}</div>
            <div class="card-url">{subdomain}.rameshkumar.space</div>
            <p class="card-desc">{meta.description}</p>
            <div class="card-arrow">
              <span>Visit</span>
              <span>→</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- FOOTER -->
    <footer>
      <div class="footer-inner">
        <span class="footer-left">© {new Date().getFullYear()} Ramesh Kumar Saragadam</span>
        <div class="footer-links">
          <a href="https://linkedin.com/in/ramesh-kumar-saragadam-9b2617142" target="_blank" rel="noopener noreferrer">LinkedIn</a>
          <a href="mailto:srameshkmr48@gmail.com">Email</a>
        </div>
      </div>
    </footer>

  </body>
</html>
