---
import { getCollection } from "astro:content";
import WritingLayout from "../../layouts/WritingLayout.astro";
import WritingVisual from "../../components/WritingVisual.astro";

const posts = (await getCollection("writing")).sort((a, b) => a.data.order - b.data.order);
---

<WritingLayout
  title="Writing — Ramesh Kumar Saragadam"
  description="Build logs from the systems I've shipped: GTM automation at Blaze Money and stablecoin infrastructure at Aspora."
  canonicalPath="/writing"
>
  <main class="wi">
    <header class="wi-head">
      <p class="section-label">Writing</p>
      <h1 class="wi-title">Build logs from <em>real systems</em></h1>
      <p class="wi-sub">Not hot takes. Detailed breakdowns of things I've built: the architecture, the tradeoffs, and what actually happened.</p>
    </header>

    <div class="wi-list">
      {posts.map((p, i) => (
        <a href={`/writing/${p.id}`} class="wi-item">
          <div class="wi-visual"><WritingVisual kind={p.data.visual} /></div>
          <div class="wi-body">
            <div class="wi-meta">
              <span class="wi-num">{String(i + 1).padStart(2, "0")}</span>
              <span>{p.data.company}</span>
              <span class="wi-dot">·</span>
              <span>{p.data.role}</span>
              {p.data.status === "draft" && <span class="wi-badge">Writing now</span>}
            </div>
            <h2 class="wi-item-title">{p.data.title}</h2>
            <p class="wi-dek">{p.data.dek}</p>
            <span class="wi-cta">{p.data.status === "draft" ? "Preview" : "Read the build"} <span>→</span></span>
          </div>
        </a>
      ))}
    </div>
  </main>
</WritingLayout>

<style>
  .wi { max-width: 1200px; margin: 0 auto; padding: 88px 48px 0; }
  .wi-head { max-width: 760px; margin-bottom: 64px; }
  .wi-title { font-size: clamp(40px, 6vw, 80px); font-weight: 800; letter-spacing: -.03em; line-height: 1; }
  .wi-title em { font-family: 'Cormorant Garamond', serif; font-style: italic; font-weight: 300; color: var(--accent); }
  .wi-sub { margin-top: 24px; font-size: 17px; line-height: 1.7; color: var(--ink-soft); max-width: 600px; }

  .wi-list { display: flex; flex-direction: column; gap: 16px; }
  .wi-item {
    display: grid; grid-template-columns: 0.9fr 1.1fr; gap: 48px; align-items: center;
    background: var(--bg-card); border: 1px solid var(--border); border-radius: 4px;
    padding: 32px; text-decoration: none; color: inherit;
    transition: border-color .25s, box-shadow .25s, transform .25s;
  }
  .wi-item:hover { border-color: var(--border-strong); box-shadow: var(--shadow-lg); transform: translateY(-2px); }
  .wi-visual { background: var(--bg); border: 1px solid var(--border); border-radius: 4px; padding: 12px; }

  .wi-meta {
    display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-bottom: 16px;
    font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: .06em; text-transform: uppercase; color: var(--ink-muted);
  }
  .wi-num { color: var(--accent); }
  .wi-badge { color: #b45309; border: 1px solid #fcd34d; background: #fffbeb; padding: 3px 8px; border-radius: 2px; font-size: 9px; letter-spacing: .1em; }
  .wi-item-title { font-size: clamp(24px, 2.8vw, 36px); font-weight: 800; letter-spacing: -.02em; line-height: 1.1; margin-bottom: 14px; }
  .wi-dek { font-size: 15px; line-height: 1.7; color: var(--ink-soft); margin-bottom: 24px; }
  .wi-cta { font-family: 'JetBrains Mono', monospace; font-size: 12px; color: var(--ink-muted); display: inline-flex; gap: 6px; transition: gap .2s, color .2s; }
  .wi-item:hover .wi-cta { gap: 12px; color: var(--accent); }

  @media (max-width: 800px) {
    .wi { padding: 56px 16px 0; }
    .wi-item { grid-template-columns: 1fr; gap: 24px; padding: 20px; }
  }
</style>
